<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">

    <style type="text/css">
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: #202124;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8pt;
        background: #ffffff;
      }

      h1,
      p {
        margin: 0;
      }

      h1 {
        color: #23527c;
        font-size: 12pt;
        line-height: 1.2;
        text-transform: uppercase;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th {
        padding: 5px 7px;
        color: #ffffff;
        border: 1px solid #23527c;
        background-color: #23527c;
        font-size: 8pt;
        text-align: left;
        text-transform: uppercase;
      }

      td {
        vertical-align: top;
      }

      .header {
        margin-bottom: 10px;
        border: 1px solid #d5dde5;
        border-left: 5px solid #23527c;
        border-radius: 8px;
        padding: 10px 12px;
        background: #f8fbfd;
      }

      .header-table td {
        border: 0;
        vertical-align: middle;
      }

      .logo-cell {
        width: 120px;
        text-align: right;
      }

      .imgLogo {
        height: 34px;
      }

      .os-box {
        display: inline-block;
        margin-top: 5px;
        padding: 4px 8px;
        border: 1px solid #23527c;
        border-radius: 6px;
        color: #23527c;
        font-size: 9pt;
        font-weight: bold;
        background: #ffffff;
      }

      .section {
        margin-bottom: 8px;
      }

      .info-table td {
        padding: 5px 7px;
        border: 1px solid #d5dde5;
        line-height: 1.35;
      }

      .info-table tr:first-child th {
        border-radius: 7px 7px 0 0;
      }

      .info-label {
        font-weight: bold;
      }

      .items-title {
        margin: 10px 0 6px;
        padding: 7px 9px;
        border: 1px solid #23527c;
        border-radius: 7px;
        background-color: #23527c;
        color: #ffffff;
        font-weight: bold;
        text-transform: uppercase;
      }

      .items-subtitle {
        margin: 12px 0 6px;
        padding: 6px 9px;
        border: 1px solid #d5dde5;
        border-left: 5px solid #23527c;
        border-radius: 7px;
        background: #f8fbfd;
        color: #23527c;
        font-weight: bold;
        text-transform: uppercase;
      }

      .items-grid {
        table-layout: fixed;
      }

      .item-cell {
        width: 50%;
        padding: 0 5px 10px 0;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .item-cell:nth-child(even) {
        padding-right: 0;
        padding-left: 5px;
      }

      .item-card {
        min-height: 318px;
        border: 1px solid #d5dde5;
        border-radius: 8px;
        background-color: #ffffff;
        box-shadow: 0 1px 3px rgba(35, 82, 124, 0.12);
        overflow: hidden;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .photo-wrap {
        position: relative;
        width: 100%;
        height: 238px;
        border-bottom: 1px solid #d5dde5;
        background-color: #f5f7f9;
        text-align: center;
        overflow: hidden;
      }

      .imgItens {
        width: 100%;
        height: 238px;
        object-fit: contain;
        image-orientation: from-image;
      }

      .item-body {
        padding: 8px 9px 9px;
      }

      .item-heading {
        display: table;
        width: 100%;
      }

      .item-name,
      .item-status-inline {
        display: table-cell;
        vertical-align: top;
      }

      .item-name {
        font-size: 8.5pt;
        font-weight: bold;
        line-height: 1.25;
        color: #202124;
      }

      .item-status-inline {
        width: 64px;
        text-align: right;
      }

      .status-line {
        margin-top: 5px;
      }

      .status {
        display: inline-block;
        min-width: 58px;
        padding: 3px 7px;
        border: 1px solid #9aa8b5;
        border-radius: 999px;
        background-color: #f3f6f8;
        color: #202124;
        font-size: 7.5pt;
        font-weight: bold;
        text-align: center;
      }

      .photo-status {
        position: absolute;
        top: 8px;
        right: 8px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.16);
      }

      .status-good {
        border-color: #3d8b58;
        background-color: #e9f6ed;
        color: #1f6b3a;
      }

      .status-bad {
        border-color: #bc4b4b;
        background-color: #fbecec;
        color: #9c2f2f;
      }

      .status-missing {
        border-color: #b37a1f;
        background-color: #fff5df;
        color: #875b13;
      }

      .comment {
        margin-top: 6px;
        color: #3d4349;
        font-size: 7.8pt;
        line-height: 1.25;
      }

      .comments-table {
        margin-top: 4px;
      }

      .comments-table td {
        min-height: 42px;
        padding: 7px;
        border: 1px solid #d5dde5;
        line-height: 1.35;
      }

      .not-applicable-list {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 5px;
      }

      .not-applicable-list td {
        padding: 7px 9px;
        border: 1px solid #d5dde5;
        border-radius: 7px;
        background: #ffffff;
        line-height: 1.3;
      }

      .not-applicable-title {
        color: #23527c;
        font-weight: bold;
      }

      .not-applicable-comment {
        margin-top: 3px;
        color: #3d4349;
        font-size: 7.8pt;
      }

      .footer {
        margin-top: 12px;
        padding-top: 7px;
        border-top: 1px solid #d5dde5;
        color: #3d4349;
        font-size: 7.5pt;
      }

      .footer table td {
        border: 0;
      }

      .footer-center {
        text-align: center;
      }

      .footer-right {
        text-align: right;
      }
    </style>
  </head>

  <body>
    <%
      const noPhoto = 'https://triunfo.pe.gov.br/pm_tr430/wp-content/uploads/2018/03/sem-foto-300x300.jpg';
      const getStatusText = (avaliacao) => avaliacao == 0 ? 'Bom' : avaliacao == 1 ? 'Ruim' : 'Faltante';
      const getStatusClass = (avaliacao) => avaliacao == 0 ? 'status-good' : avaliacao == 1 ? 'status-bad' : 'status-missing';
      const normalizeText = (text) => text.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const isNaoSeAplica = (item) => item && item.comentario && normalizeText(item.comentario) === 'nao se aplica';
      const itensAvaliados = checklistItens.filter((item) => !isNaoSeAplica(item));
      const itensNaoSeAplica = checklistItens.filter(isNaoSeAplica);
    %>

    <div class="header">
      <table class="header-table">
        <tr>
          <td>
            <h1>Registro Fotográfico - Compressor - Superfrio</h1>
            <div class="os-box">OS: <%= checklist.nos %></div>
          </td>
          <td class="logo-cell">
            <img src="https://superfrio.netlify.app/static/media/logo.a6ef6318.png" class="imgLogo">
          </td>
        </tr>
      </table>
    </div>

    <div class="section">
      <table class="info-table">
        <tr>
          <th colspan="2">Informações Gerais</th>
        </tr>
        <tr>
          <td style="width:60%">
            <p><span class="info-label">Cliente:</span> <%= checklist.idcliente.nome %></p>
            <p><span class="info-label">Cidade / UF:</span> <%= checklist.idcliente.cidade %> / <%= checklist.idcliente.uf %></p>
          </td>
          <td style="width:40%">
            <p><span class="info-label">Data Entrada:</span> <%= dataentrada %></p>
            <p><span class="info-label">Garantia:</span> <%= checklist.garantia == false ? "Não" : "Sim" %></p>
          </td>
        </tr>
        <tr>
          <th colspan="2">Informações do Compressor</th>
        </tr>
        <tr>
          <td>
            <p><span class="info-label">Fabricante:</span> <%= checklist.idfabricante.nome %></p>
            <p><span class="info-label">Modelo:</span> <%= checklist.idcompressor.modelo %></p>
            <p><span class="info-label">Tensão:</span> <%= checklist.tensao %></p>
          </td>
          <td>
            <p><span class="info-label">N. Série:</span> <%= checklist.nserie %></p>
            <p><span class="info-label">N. Ativo:</span> <%= checklist.nativo %></p>
            <p><span class="info-label">Gás:</span> <%= checklist.gas %></p>
          </td>
        </tr>
      </table>
    </div>

    <div class="items-title">Avarias</div>

    <table class="items-grid">
      <% for (var i = 0; i < itensAvaliados.length; i += 2) { %>
        <tr>
          <% for (var col = 0; col < 2; col++) { %>
            <%
              var item = itensAvaliados[i + col];
            %>
            <% if (item) { %>
              <td class="item-cell">
                <div class="item-card">
                  <div class="photo-wrap">
                    <img src="<%= item.foto ? item.foto : noPhoto %>" class="imgItens"/>
                    <span class="status photo-status <%= getStatusClass(item.avaliacao) %>"><%= getStatusText(item.avaliacao) %></span>
                  </div>
                  <div class="item-body">
                    <div class="item-heading">
                      <p class="item-name"><%= item.nomeitem %></p>
                    </div>
                    <% if (item.comentario) { %>
                      <p class="comment"><span class="info-label">Comentário:</span> <%= item.comentario %></p>
                    <% } %>
                  </div>
                </div>
              </td>
            <% } else { %>
              <td class="item-cell"></td>
            <% } %>
          <% } %>
        </tr>
      <% } %>
    </table>

    <% if (itensNaoSeAplica.length > 0) { %>
      <div class="items-subtitle">Não se aplica</div>

      <table class="not-applicable-list">
        <% for (var i = 0; i < itensNaoSeAplica.length; i++) { %>
          <tr>
            <td>
              <p class="not-applicable-title"><%= itensNaoSeAplica[i].nomeitem %></p>
              <p class="not-applicable-comment"><span class="info-label">Comentário:</span> <%= itensNaoSeAplica[i].comentario %></p>
            </td>
          </tr>
        <% } %>
      </table>
    <% } %>

    <table class="comments-table">
      <tr>
        <th>Comentários Gerais</th>
      </tr>
      <tr>
        <td><%= checklist.comentarios %></td>
      </tr>
    </table>

    <div class="footer">
      <table>
        <tr>
          <td><strong>Contato:</strong> (11) 4599-5239</td>
          <td class="footer-center"><strong>Email:</strong> compressores@superfriosr.com.br</td>
          <td class="footer-right"><strong>CNPJ:</strong> 18.553.796/0001-75</td>
        </tr>
      </table>
    </div>
  </body>
</html>
